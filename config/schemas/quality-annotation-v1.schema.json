{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sanctum.local/schemas/quality-annotation-v1.schema.json",
  "title": "Sanctum append-only quality annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_id",
    "operation_id",
    "interaction_id",
    "recorded_at",
    "source",
    "authority_effect",
    "owner_rating",
    "evaluator",
    "benchmark",
    "scores",
    "pass",
    "semantic_failure_category",
    "grounding",
    "citation"
  ],
  "properties": {
    "schema_version": {"const": "sanctum.quality-annotation/v1"},
    "annotation_id": {"type": "string", "pattern": "^qa-[a-f0-9]{64}$"},
    "operation_id": {"$ref": "#/definitions/id"},
    "interaction_id": {"$ref": "#/definitions/id"},
    "recorded_at": {"$ref": "#/definitions/timestamp"},
    "source": {"enum": ["OWNER_MANUAL", "EVALUATOR", "BENCHMARK_REPLAY"]},
    "authority_effect": {"const": "NONE"},
    "owner_rating": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "evaluator": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluator_id", "evaluator_version", "model", "model_revision"],
          "properties": {
            "evaluator_id": {"$ref": "#/definitions/id"},
            "evaluator_version": {"$ref": "#/definitions/id"},
            "model": {"$ref": "#/definitions/id"},
            "model_revision": {"$ref": "#/definitions/idOrNull"}
          }
        }
      ]
    },
    "benchmark": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["benchmark_id", "benchmark_version", "test_case_id", "test_case_version"],
          "properties": {
            "benchmark_id": {"$ref": "#/definitions/id"},
            "benchmark_version": {"$ref": "#/definitions/id"},
            "test_case_id": {"$ref": "#/definitions/id"},
            "test_case_version": {"$ref": "#/definitions/id"}
          }
        }
      ]
    },
    "scores": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": {"$ref": "#/definitions/id"},
          "value": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "pass": {"type": ["boolean", "null"]},
    "semantic_failure_category": {
      "enum": [
        "NONE",
        "FACTUAL_ERROR",
        "INSTRUCTION_MISS",
        "INCOMPLETE",
        "UNSUPPORTED_CLAIM",
        "CITATION_ERROR",
        "GROUNDING_ERROR",
        "SAFETY_ERROR",
        "OTHER_BOUNDED"
      ]
    },
    "grounding": {"$ref": "#/definitions/signal"},
    "citation": {"$ref": "#/definitions/signal"}
  },
  "allOf": [
    {
      "if": {"properties": {"source": {"const": "OWNER_MANUAL"}}},
      "then": {"properties": {"owner_rating": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"source": {"const": "EVALUATOR"}}},
      "then": {"properties": {"evaluator": {"type": "object"}}}
    },
    {
      "if": {"properties": {"source": {"const": "BENCHMARK_REPLAY"}}},
      "then": {"properties": {"benchmark": {"type": "object"}}}
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]*$"
    },
    "idOrNull": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]*$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "signal": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score"],
          "properties": {
            "status": {"enum": ["NOT_EVALUATED", "PASS", "PARTIAL", "FAIL"]},
            "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        }
      ]
    }
  }
}
