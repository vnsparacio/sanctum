{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sanctum.local/schemas/benchmark-dataset-v1.schema.json",
  "title": "Sanctum curated benchmark dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_version", "created_at", "authority_effect", "cases"],
  "properties": {
    "schema_version": {"const": "sanctum.benchmark-dataset/v1"},
    "dataset_id": {"$ref": "#/definitions/id"},
    "dataset_version": {"$ref": "#/definitions/id"},
    "created_at": {"$ref": "#/definitions/timestamp"},
    "authority_effect": {"const": "NONE"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_case_id", "test_case_version", "interaction_id", "user_query", "reference_response"],
        "properties": {
          "test_case_id": {"$ref": "#/definitions/id"},
          "test_case_version": {"$ref": "#/definitions/id"},
          "interaction_id": {"$ref": "#/definitions/id"},
          "user_query": {"type": "string", "minLength": 1, "maxLength": 16384},
          "reference_response": {"type": ["string", "null"], "maxLength": 32768}
        }
      }
    }
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]*$"},
    "timestamp": {"type": "string", "maxLength": 32, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
  }
}
