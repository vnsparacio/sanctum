{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "findings"],
  "properties": {
    "sources": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "title", "published_at", "kind", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "url": {"type": "string", "minLength": 9, "maxLength": 2000},
          "title": {"type": "string", "minLength": 4, "maxLength": 300},
          "published_at": {"type": ["string", "null"]},
          "kind": {"enum": ["primary", "community", "paper", "repository", "release_notes", "security_research"]},
          "summary": {"type": "string", "minLength": 20, "maxLength": 1200}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "sanctum_connection", "recommendation", "source_ids", "labels"],
        "properties": {
          "title": {"type": "string", "minLength": 8, "maxLength": 140},
          "summary": {"type": "string", "minLength": 20, "maxLength": 1600},
          "sanctum_connection": {"type": "string", "minLength": 20, "maxLength": 1200},
          "recommendation": {"enum": ["Investigate", "Watch", "Ignore"]},
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {"type": "string", "minLength": 1, "maxLength": 80}
          },
          "labels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {"enum": ["product-discovery", "architecture", "security", "reliability", "agent-quality", "research", "documentation"]}
          }
        }
      }
    }
  }
}
