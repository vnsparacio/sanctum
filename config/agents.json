{
  "schema_version": 1,
  "project": {
    "linear_project_slug": "sanctum-v12-6fe3a63e0c69",
    "github_repository": "vnsparacio/sanctum",
    "integration_branch": "v1.2-dev",
    "implementation_gate": {
      "status": "Ready for Agent",
      "label": "symphony"
    },
    "human_review_status": "Human Review"
  },
  "runtime": {
    "prefix_env": "SANCTUM_AGENT_PREFIX",
    "default_prefix": "~/.sanctum/agents-v1.2",
    "lock_stale_seconds": 7200,
    "log_output_limit_bytes": 262144
  },
  "models": {
    "platform_build": {"model": "gpt-5.6-sol", "reasoning": "high"},
    "repo_steward": {"model": "gpt-5.6-terra", "reasoning": "medium"},
    "product_scout": {"model": "gpt-5.6-terra", "reasoning": "medium"},
    "triage": {"model": "gpt-5.6-luna", "reasoning": "medium"},
    "implementation": {"model": "gpt-5.6-sol", "reasoning": "medium"},
    "reviewer": {"model": "gpt-5.6-sol", "reasoning": "high"}
  },
  "roles": {
    "repo_steward": {
      "cadence": "weekdays",
      "write_enabled": false,
      "wall_clock_seconds": 900,
      "max_items": 8,
      "max_sources": 0,
      "max_issues_created": 3,
      "max_retries": 1,
      "max_turns": 3,
      "max_tokens": 120000,
      "repository_scope": ["AGENTS.md", "WORKFLOW.md", ".github", "config", "docs", "gate", "reliability", "router", "scripts", "tests"]
    },
    "product_scout": {
      "cadence": "monday_wednesday_friday",
      "write_enabled": false,
      "wall_clock_seconds": 900,
      "max_items": 8,
      "max_sources": 12,
      "max_issues_created": 3,
      "max_retries": 1,
      "max_turns": 3,
      "max_tokens": 120000,
      "repository_scope": []
    },
    "triage": {
      "cadence": "daily",
      "write_enabled": false,
      "wall_clock_seconds": 600,
      "max_items": 20,
      "max_sources": 0,
      "max_issues_created": 0,
      "max_retries": 1,
      "max_turns": 3,
      "max_tokens": 80000,
      "repository_scope": []
    },
    "implementation": {
      "cadence": "continuous_symphony",
      "write_enabled": false,
      "wall_clock_seconds": 3600,
      "max_items": 1,
      "max_sources": 0,
      "max_issues_created": 0,
      "max_retries": 2,
      "max_turns": 8,
      "max_tokens": 500000,
      "repository_scope": []
    },
    "reviewer": {
      "cadence": "on_human_review",
      "write_enabled": false,
      "wall_clock_seconds": 1200,
      "max_items": 1,
      "max_sources": 0,
      "max_issues_created": 0,
      "max_retries": 1,
      "max_turns": 3,
      "max_tokens": 180000,
      "repository_scope": []
    }
  },
  "symphony": {
    "binary_env": "SANCTUM_SYMPHONY_BIN",
    "default_binary": "symphony",
    "workflow": "WORKFLOW.md",
    "max_concurrency": 1,
    "shutdown_grace_seconds": 10
  }
}
